# ---- SQL Server test DB (separate from production DPP/CDPMC/CDP2000) ----
DB_SERVER=YOUR_SQL_SERVER\INSTANCE
DB_NAME=FaceEvalTest
DB_USER=sa
DB_PASSWORD=changeme
DB_DRIVER=ODBC Driver 17 for SQL Server

# ---- Local photo root ----
# Studio photos: {ALGOTEST_ROOT}\Studio\{TeamKey}\*.jpg
# Game photos:   {ALGOTEST_ROOT}\Game\{GameNumber}\*.jpg
ALGOTEST_ROOT=C:\AlgoTest

# ---- Model weight paths (all relative to face_eval/) ----
MODEL_DIR=models
FACE_CROPS_DIR=face_crops

# ---- LVFace weights (auto-downloaded on first run) ----
# Repo on Hugging Face Hub - ONNX format (no Python model-def file needed)
LVFACE_HF_REPO=bytedance-research/LVFace
# ONNX filename within the repo (check HF repo; e.g. LVFace-B_WebFace4M.onnx)
LVFACE_HF_FILENAME=LVFace-B_WebFace4M.onnx

# ---- Detection threshold override ----
# Production uses 0.96 for game, 0.70 for studio. Eval uses 0.85 by default
# so borderline faces surface - re-tighten via the Streamlit slider.
MTCNN_THRESHOLD=0.85
MIN_FACE_SIZE=30
