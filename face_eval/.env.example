# ---- SQL Server test DB (separate from production DPP/CDPMC/CDP2000) ----
DB_SERVER=YOUR_SQL_SERVER\INSTANCE
DB_NAME=FaceEvalTest
DB_USER=sa
DB_PASSWORD=changeme
DB_DRIVER=ODBC Driver 17 for SQL Server

# ---- Local photo root ----
# Studio photos: {ALGOTEST_ROOT}\Studio\{TeamKey}\*.jpg
# Game photos:   {ALGOTEST_ROOT}\Game\{GameNumber}\*.jpg
ALGOTEST_ROOT=C:\AlgoTest

# ---- Model weight paths (all relative to face_eval/) ----
MODEL_DIR=models
FACE_CROPS_DIR=face_crops

# ---- LVFace PyTorch weights (auto-downloaded on first run) ----
# Repo on Hugging Face Hub (ByteDance publishes both .pt and .onnx; we use .pt)
LVFACE_HF_REPO=bytedance-research/LVFace
# .pt weight filename within the repo (e.g. LVFace-B_WebFace4M.pt)
LVFACE_HF_FILENAME=LVFace-B_WebFace4M.pt
# Backbone name passed to backbones.get_model() (see LVFace inference.py).
# Common values: vit_t, vit_s, vit_b, vit_l - match the weight you download.
LVFACE_MODEL_NAME=vit_b
# Local path where you cloned https://github.com/bytedance/LVFace
# (loader adds this to sys.path so `from backbones import get_model` works).
LVFACE_REPO_DIR=C:\path\to\LVFace

# ---- Detection threshold override ----
# Production uses 0.96 for game, 0.70 for studio. Eval uses 0.85 by default
# so borderline faces surface - re-tighten via the Streamlit slider.
MTCNN_THRESHOLD=0.85
MIN_FACE_SIZE=30
